# Copy this file to .env. Credentials deliberately have no committed defaults.
APP_ENV=development
AI_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=
DEMO_PASSWORD=

# Local native server: fill a postgresql+psycopg://... URL.
# Docker Compose supplies its own internal database URL for the app.
DATABASE_URL=
POSTGRES_USER=clinicflow
POSTGRES_DB=clinicflow
POSTGRES_PASSWORD=
POSTGRES_PORT=54329

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
COOKIE_SECURE=false
PORT=8000

